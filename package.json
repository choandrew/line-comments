{
  "name": "line-comments",
  "displayName": "Line Comments",
  "description": "GitHub-style line comment threads in VS Code, outside any pull request, shared through a folder or an S3 bucket such as SeaweedFS.",
  "publisher": "choandrew",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/choandrew/line-comments"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "comments",
    "code review",
    "annotations",
    "review"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Runs git in the workspace to track lines across commits."
    }
  },
  "contributes": {
    "configuration": {
      "title": "Line Comments",
      "properties": {
        "lineComments.location": {
          "type": "string",
          "default": "~/.line-comments",
          "scope": "resource",
          "markdownDescription": "Where comment threads live: a folder (`~` and paths relative to the workspace folder work), or an S3 location such as `s3://bucket/prefix`. Each repo's threads go under `<location>/<owner>/<repo>/`, so one location serves every repo."
        },
        "lineComments.s3.endpoint": {
          "type": "string",
          "scope": "resource",
          "markdownDescription": "S3 endpoint URL for an `s3://` location, e.g. `http://seaweedfs:8333` or `https://s3.us-east-1.amazonaws.com`. Set the access key with **Line Comments: Set S3 Credentials**."
        },
        "lineComments.s3.region": {
          "type": "string",
          "default": "us-east-1",
          "scope": "resource",
          "markdownDescription": "S3 signing region. SeaweedFS and MinIO accept any value."
        }
      }
    },
    "commands": [
      {
        "command": "lineComments.comment",
        "title": "Comment"
      },
      {
        "command": "lineComments.archive",
        "title": "Archive Thread",
        "icon": "$(archive)"
      },
      {
        "command": "lineComments.unarchive",
        "title": "Unarchive Thread",
        "icon": "$(discard)"
      },
      {
        "command": "lineComments.delete",
        "title": "Delete Thread",
        "icon": "$(trash)"
      },
      {
        "command": "lineComments.toggleArchived",
        "title": "Show/Hide Archived Threads",
        "category": "Line Comments",
        "icon": "$(archive)"
      },
      {
        "command": "lineComments.setS3Credentials",
        "title": "Set S3 Credentials",
        "category": "Line Comments"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "lineComments.comment",
          "when": "false"
        },
        {
          "command": "lineComments.archive",
          "when": "false"
        },
        {
          "command": "lineComments.unarchive",
          "when": "false"
        },
        {
          "command": "lineComments.delete",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "lineComments.comment",
          "group": "inline",
          "when": "commentController == line-comments"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "lineComments.archive",
          "group": "navigation@1",
          "when": "commentController == line-comments && commentThread == open"
        },
        {
          "command": "lineComments.unarchive",
          "group": "navigation@1",
          "when": "commentController == line-comments && commentThread == archived"
        },
        {
          "command": "lineComments.delete",
          "group": "navigation@2",
          "when": "commentController == line-comments && commentThread"
        }
      ]
    }
  },
  "scripts": {
    "check": "tsc -p . && node --test",
    "package": "vsce package -o line-comments.vsix"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "5.9.3"
  }
}
