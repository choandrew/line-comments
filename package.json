{
  "name": "line-comments",
  "displayName": "Line Comments",
  "description": "GitHub-style line comment threads in VS Code, outside any pull request, shared through a folder or an S3 bucket such as SeaweedFS.",
  "publisher": "choandrew",
  "version": "0.5.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/choandrew/line-comments"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "comments",
    "code review",
    "annotations",
    "review"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Runs git in the workspace to track lines across commits."
    }
  },
  "contributes": {
    "configuration": {
      "title": "Line Comments",
      "properties": {
        "lineComments.location": {
          "type": "string",
          "default": "~/.line-comments",
          "scope": "resource",
          "markdownDescription": "Where comment threads live: a folder (`~` and paths relative to the workspace folder work), or an S3 location such as `s3://bucket/prefix`. Each repo's threads go under `<location>/<owner>/<repo>/`, so one location serves every repo."
        },
        "lineComments.s3.endpoint": {
          "type": "string",
          "scope": "resource",
          "markdownDescription": "S3 endpoint URL for an `s3://` location, e.g. `http://seaweedfs:8333` or `https://s3.us-east-1.amazonaws.com`. Requests go without a key until the store refuses one; then the side bar asks for it (**Line Comments: Set S3 Credentials**)."
        },
        "lineComments.s3.region": {
          "type": "string",
          "default": "us-east-1",
          "scope": "resource",
          "markdownDescription": "S3 signing region. SeaweedFS and MinIO accept any value."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lineComments",
          "title": "Line Comments",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "lineComments": [
        {
          "id": "lineComments.threads",
          "name": "Threads"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lineComments.threads",
        "when": "lineComments.state == credentials",
        "contents": "This S3 location turned away a request without an access key. Enter one to reach your comments.\n[Set S3 Credentials](command:lineComments.setS3Credentials)"
      },
      {
        "view": "lineComments.threads",
        "when": "lineComments.state == offMain",
        "contents": "Comments show only on the default branch, because their line numbers refer to it.\n[Switch to Default Branch](command:lineComments.switchToDefault)"
      },
      {
        "view": "lineComments.threads",
        "when": "lineComments.state == ready",
        "contents": "No comments yet. Hover a line number in any file and click + to start a thread."
      },
      {
        "view": "lineComments.threads",
        "when": "lineComments.state == none",
        "contents": "Open a git repository with an origin remote to use Line Comments."
      }
    ],
    "commands": [
      {
        "command": "lineComments.comment",
        "title": "Comment"
      },
      {
        "command": "lineComments.archive",
        "title": "Archive Thread",
        "icon": "$(archive)"
      },
      {
        "command": "lineComments.unarchive",
        "title": "Unarchive Thread",
        "icon": "$(discard)"
      },
      {
        "command": "lineComments.delete",
        "title": "Delete Thread",
        "icon": "$(trash)"
      },
      {
        "command": "lineComments.toggleArchived",
        "title": "Show/Hide Archived Threads",
        "category": "Line Comments",
        "icon": "$(archive)"
      },
      {
        "command": "lineComments.setS3Credentials",
        "title": "Set S3 Credentials",
        "category": "Line Comments",
        "icon": "$(key)"
      },
      {
        "command": "lineComments.refresh",
        "title": "Refresh",
        "category": "Line Comments",
        "icon": "$(refresh)"
      },
      {
        "command": "lineComments.switchToDefault",
        "title": "Switch to Default Branch",
        "category": "Line Comments"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "lineComments.comment",
          "when": "false"
        },
        {
          "command": "lineComments.archive",
          "when": "false"
        },
        {
          "command": "lineComments.unarchive",
          "when": "false"
        },
        {
          "command": "lineComments.delete",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "lineComments.comment",
          "group": "inline",
          "when": "commentController == line-comments"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "lineComments.archive",
          "group": "navigation@1",
          "when": "commentController == line-comments && commentThread == open"
        },
        {
          "command": "lineComments.unarchive",
          "group": "navigation@1",
          "when": "commentController == line-comments && commentThread == archived"
        },
        {
          "command": "lineComments.delete",
          "group": "navigation@2",
          "when": "commentController == line-comments && commentThread"
        }
      ],
      "view/title": [
        {
          "command": "lineComments.toggleArchived",
          "group": "navigation@1",
          "when": "view == lineComments.threads"
        },
        {
          "command": "lineComments.refresh",
          "group": "navigation@2",
          "when": "view == lineComments.threads"
        },
        {
          "command": "lineComments.setS3Credentials",
          "group": "settings",
          "when": "view == lineComments.threads"
        }
      ]
    }
  },
  "scripts": {
    "check": "tsc -p . && node --test",
    "package": "vsce package -o line-comments.vsix"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "5.9.3"
  }
}
